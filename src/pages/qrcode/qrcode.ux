<template>
  <div class="qr-page" @click="routeBack">
    <!-- Botão voltar no topo -->
    <img class="back-btn" src="/common/back.png" @click="routeBack" />

    <!-- Título do serviço -->
    <text class="qr-title">{{ title }}</text>

    <!-- QR Code ampliado com fundo preto AMOLED e quadrados brancos -->
    <div class="qr-box">
      <img class="qr-img" src="{{ qrDark }}" />
    </div>

    <!-- Indicador de retorno -->
    <text class="qr-hint">Toque para voltar</text>
  </div>
</template>

<style>
.qr-page {
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  background-color: #000000;
  padding-top: 24px;
  padding-bottom: 24px;
}

.back-btn {
  position: absolute;
  top: 24px;
}

.qr-title {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
  margin-top: 48px;
  text-align: center;
}

.qr-box {
  width: 184px;
  height: 184px;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}

.qr-img {
  width: 184px;
  height: 184px;
}

.qr-hint {
  color: #8e8e93;
  font-size: 14px;
  text-align: center;
  margin-bottom: 12px;
}
</style>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"

export default {
  protected: {
    id: "",
    title: "QR Code",
    qrDark: ""
  },

  onInit() {
    if (!this.title) {
      this.title = "QR Code"
    }
  },

  onBackPress() {
    this.routeBack()
    return true
  },

  routeBack() {
    try {
      vibrator.vibrate({ mode: "short" })
    } catch (e) {}
    router.back()
  }
}
</script>
