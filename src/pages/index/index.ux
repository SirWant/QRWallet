<template>
  <div class="list-page">
    <list class="app-list" bounces="true" if="{{ contentVisible }}">
      <list-item
        for="{{ items }}"
        type="app"
        class="app-item"
        @click="openItem($item)"
      >
        <div class="app-card">
          <img class="app-icon" src="{{ $item.icon }}" />
          <text class="app-name">{{ $item.title }}</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<style>
.list-page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 100%;
  height: 100%;
}

.app-list {
  flex: 1;
  width: 100%;
  height: 100%;
}

.app-item {
  width: 100%;
  height: 160px;
  align-items: center;
  justify-content: center;
}

.app-card {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.app-icon {
  width: 96px;
  height: 96px;
}

.app-name {
  color: #ffffff;
  font-size: 24px;
  font-weight: normal;
  text-align: center;
  margin-top: 6px;
}
</style>

<script>
import router from "@system.router"
import vibrator from "@system.vibrator"

const APP_ITEMS = [
  {
    id: "whatsapp",
    title: "WhatsApp",
    icon: "/common/icons/whatsapp.png",
    qrDark: "/common/qrcodes/whatsapp_dark.png"
  },
  {
    id: "telegram",
    title: "Telegram",
    icon: "/common/icons/telegram.png",
    qrDark: "/common/qrcodes/telegram_dark.png"
  },
  {
    id: "instagram",
    title: "Instagram",
    icon: "/common/icons/instagram.png",
    qrDark: "/common/qrcodes/instagram_dark.png"
  },
  {
    id: "mail",
    title: "E-mail",
    icon: "/common/icons/mail.png",
    qrDark: "/common/qrcodes/mail_dark.png"
  },
  {
    id: "github",
    title: "GitHub",
    icon: "/common/icons/github.png",
    qrDark: "/common/qrcodes/github_dark.png"
  },
  {
    id: "vk",
    title: "VK",
    icon: "/common/icons/vk.png",
    qrDark: "/common/qrcodes/vk_dark.png"
  },
  {
    id: "phone",
    title: "Telefone",
    icon: "/common/icons/phone.png",
    qrDark: "/common/qrcodes/phone_dark.png"
  },
  {
    id: "wifi",
    title: "Wi-Fi",
    icon: "/common/icons/wifi.png",
    qrDark: "/common/qrcodes/wifi_dark.png"
  }
]

export default {
  private: {
    contentVisible: false,
    items: []
  },

  onInit() {
    this.items = APP_ITEMS
  },

  onShow() {
    this.contentVisible = true
  },

  onHide() {
    this.contentVisible = false
  },

  openItem(item) {
    try {
      vibrator.vibrate({ mode: "short" })
    } catch (e) {}

    router.push({
      uri: "/pages/qrcode",
      params: {
        id: item.id,
        title: item.title,
        qrDark: item.qrDark
      }
    })
  }
}
</script>
