<script>
import device from "@system.device"

// Configuração padrão para a Xiaomi Smart Band 10 (formato pílula/runway)
global.screenShape = "pill-shaped"
global.isPillShaped = true
global.screenSize = { width: 192, height: 490 }

device.getInfo({
  success: function (deviceRet) {
    if (deviceRet) {
      global.screenSize = {
        width: deviceRet.screenWidth || 192,
        height: deviceRet.screenHeight || 490
      }
      global.screenShape = deviceRet.screenShape || "pill-shaped"
      global.isPillShaped = deviceRet.screenShape !== "rect" && deviceRet.screenShape !== "circle"
    }
  }
})

global.getTime = function () {
  const date = new Date()
  const hour = date.getHours().toString().padStart(2, "0")
  const minute = date.getMinutes().toString().padStart(2, "0")
  return hour + ":" + minute
}

const B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

global.base64ToArrayBuffer = function (base64) {
  if (!base64 || typeof base64 !== "string") return new ArrayBuffer(0)
  base64 = base64.replace(/[\s\r\n]/g, "")
  const len = base64.length
  if (len === 0) return new ArrayBuffer(0)

  let paddingCount = 0
  if (base64.charAt(len - 1) === "=") paddingCount++
  if (base64.charAt(len - 2) === "=") paddingCount++

  const bufferLength = (len * 3) / 4 - paddingCount
  const bytes = new Uint8Array(bufferLength)

  let p = 0
  for (let i = 0; i < len; i += 4) {
    const encoded1 = B64_CHARS.indexOf(base64[i])
    const encoded2 = B64_CHARS.indexOf(base64[i + 1])
    const encoded3 = B64_CHARS.indexOf(base64[i + 2])
    const encoded4 = B64_CHARS.indexOf(base64[i + 3])

    if (encoded1 < 0 || encoded2 < 0) continue

    bytes[p++] = (encoded1 << 2) | (encoded2 >> 4)
    if (encoded3 !== -1 && encoded3 !== 64 && p < bufferLength) {
      bytes[p++] = ((encoded2 & 15) << 4) | (encoded3 >> 2)
    }
    if (encoded4 !== -1 && encoded4 !== 64 && p < bufferLength) {
      bytes[p++] = ((encoded3 & 3) << 6) | (encoded4 & 63)
    }
  }
  return bytes.buffer
}

export default {
  onCreate() {},
  onDestroy() {}
}
</script>
